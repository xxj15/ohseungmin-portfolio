---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { withBase } from '../lib/paths';

interface Props {
  title: string;
  ogTitle?: string;
  noindex?: boolean;
  description?: string;
}
const { title, ogTitle, noindex = false, description = site.description } = Astro.props;
const resumeHref = site.contact.resumePdf ? withBase(site.contact.resumePdf) : undefined;
const showResume = !!resumeHref;
/** 링크 공유 미리보기(카카오톡 · 슬랙 등) 대표 이미지. 없으면 카카오가 페이지 첫 이미지(리포트 표지)를 고른다. */
const ogImage = new URL(withBase('/og.png'), Astro.site).href;

/** 글꼴은 렌더링을 막지 않게 불러온다. CDN이 막혀도 폴백 글꼴로 바로 보인다.
 *  영문·숫자는 Inter, 한글은 Pretendard(--font-sans 순서). */
const PRETENDARD_CSS =
  'https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css';
const INTER_CSS = 'https://fonts.googleapis.com/css2?family=Inter:wght@400..800&display=swap';
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="오승민 · Strategy & Financial Research" />
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={INTER_CSS} media="print" onload="this.media='all'" />
    <link rel="stylesheet" href={PRETENDARD_CSS} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={INTER_CSS} /><link rel="stylesheet" href={PRETENDARD_CSS} /></noscript>
  </head>
  <body>
    <Nav showResume={showResume} resumeHref={resumeHref} />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/nav';
      import '../scripts/reveal';
      import '../scripts/countup';
    </script>
  </body>
</html>

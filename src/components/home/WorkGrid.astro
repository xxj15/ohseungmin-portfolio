---
import { cases } from '../../data/cases';
import { casePath } from '../../lib/paths';
import SectionHead from './SectionHead.astro';
import CaseCard from './CaseCard.astro';
---

<section id="work" class="sec">
  <div class="wrap">
    <SectionHead no="01" label="SELECTED WORK" title="주요 프로젝트" />
    <div class="grid" data-work-grid>
      {cases.map((c) => <CaseCard card={c.card} href={casePath(c.slug)} />)}
    </div>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin-top: 56px; }
  @media (max-width: 900px) {
    .grid { grid-template-columns: minmax(0, 1fr); gap: 14px; margin-top: 32px; }
  }
</style>

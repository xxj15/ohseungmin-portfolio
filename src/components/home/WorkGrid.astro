---
import SectionHead from './SectionHead.astro';
import FeaturedHanwha from './work/FeaturedHanwha.astro';
import FeaturedIm from './work/FeaturedIm.astro';
import FeaturedRci from './work/FeaturedRci.astro';
import AdditionalList from './work/AdditionalList.astro';
---

<section id="work" class="sec">
  <div class="wrap">
    <SectionHead no="01" label="Selected Work" title="주요 프로젝트" />

    <div class="group" data-work-grid>
      <h3 class="gl">Featured Work</h3>
      <FeaturedHanwha />
      <div class="pair">
        <FeaturedIm />
        <FeaturedRci />
      </div>
    </div>

    <div class="group">
      <h3 class="gl">Additional Work</h3>
      <AdditionalList />
    </div>
  </div>
</section>

<style>
  .group { margin-top: 56px; }
  .group + .group { margin-top: 88px; }
  .gl { margin-bottom: 20px; font-size: 13px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-3); }
  .pair { margin-top: 24px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  @media (max-width: 1000px) {
    .pair { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 900px) {
    .group { margin-top: 36px; }
    .group + .group { margin-top: 56px; }
    .pair { margin-top: 16px; gap: 16px; }
  }
</style>

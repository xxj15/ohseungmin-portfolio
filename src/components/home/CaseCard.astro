---
import type { CaseCard } from '../../data/types';

interface Props {
  card: CaseCard;
  href: string;
  /** 목록 번호 (01, 02 …) */
  no: string;
}
const { card, href, no } = Astro.props;
---

<a class="card" href={href} data-case-card data-reveal>
  <div class="top">
    <span class="no">{no}</span>
    <span class="cat">{card.category}</span>
    <span class="arrow" aria-hidden="true">→</span>
  </div>
  <p class="org">{card.org}<span>{card.role}</span></p>
  <h3>{card.title}</h3>
  <p class="sum">{card.summary}</p>
  <div class="outcome">
    <p class="val">{card.outcome}</p>
    {card.outcomeSub && <p class="sub">{card.outcomeSub}</p>}
  </div>
</a>

<style>
  .card {
    /* 같은 줄 카드끼리 제목·요약·결과 높이를 맞춘다(행 5개를 부모 그리드와 공유) */
    display: grid; grid-row: span 5; grid-template-rows: subgrid; row-gap: 0; align-content: start;
    color: inherit; border-top: 1px solid var(--ink); padding-top: 22px; margin-bottom: 80px;
    background-image: linear-gradient(var(--navy), var(--navy)); background-repeat: no-repeat;
    background-size: 0 2px; background-position: 0 -1px;
    transition: background-size 0.4s var(--ease);
  }
  .card:hover, .card:focus-visible { background-size: 100% 2px; }

  .top { display: flex; align-items: baseline; gap: 14px; font-size: 12px; letter-spacing: 0.04em; }
  .no { color: var(--navy); font-weight: 600; font-variant-numeric: tabular-nums; }
  .cat { color: var(--ink-3); }
  .arrow {
    margin-left: auto; font-size: 18px; letter-spacing: 0; color: var(--navy);
    opacity: 0; transform: translateX(-6px); transition: opacity 0.24s, transform 0.24s var(--ease);
  }
  .card:hover .arrow, .card:focus-visible .arrow { opacity: 1; transform: none; }

  .org { margin-top: 26px; font-size: 14px; font-weight: 700; color: var(--ink); }
  .org span { font-weight: 400; color: var(--ink-3); }
  .org span::before { content: '·'; margin: 0 8px; color: var(--line-strong); }
  h3 {
    margin-top: 10px; font-size: 24px; font-weight: 700; letter-spacing: -0.025em; line-height: 1.4;
    transition: color 0.24s;
  }
  .card:hover h3 { color: var(--navy); }
  .sum { margin-top: 14px; font-size: 15px; color: var(--ink-2); line-height: 1.75; }

  .outcome { padding-top: 28px; }
  .val {
    padding-left: 14px; border-left: 2px solid var(--navy);
    font-size: 18px; font-weight: 700; color: var(--navy); letter-spacing: -0.01em; line-height: 1.45;
  }
  .sub { margin-top: 4px; padding-left: 16px; font-size: 14px; color: var(--ink-3); }

  @media (prefers-reduced-motion: reduce) {
    .card, .arrow, h3 { transition: none; }
  }
  @media (max-width: 900px) {
    .card { margin-bottom: 48px; }
    .org { margin-top: 18px; }
    h3 { font-size: 20px; }
    .sum { font-size: 14px; }
    .outcome { padding-top: 20px; }
    .arrow { opacity: 1; transform: none; }
  }
</style>

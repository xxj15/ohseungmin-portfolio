---
interface Props {
  no: string;
  label: string;
  title: string;
  lede?: string;
}
const { no, label, title, lede } = Astro.props;
---

<div class="head" data-reveal>
  <div>
    <p class="sec-label"><span>{no}</span>{label}</p>
    <h2 class="h2">{title}</h2>
    {lede && <p class="lede">{lede}</p>}
  </div>
  <slot />
</div>

<style>
  .head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; }
</style>

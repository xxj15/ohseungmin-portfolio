---
import { cases } from '../../data/cases';
import { casePath } from '../../lib/paths';
import SectionHead from './SectionHead.astro';
import CaseCard from './CaseCard.astro';
---

<section id="work" class="sec" data-rail-root>
  <div class="wrap">
    <SectionHead no="01" label="SELECTED WORK" title="주요 프로젝트">
      <div class="arrows">
        <button type="button" aria-label="이전 프로젝트" data-rail-prev disabled>←</button>
        <button type="button" aria-label="다음 프로젝트" data-rail-next>→</button>
      </div>
    </SectionHead>
    <div class="rail" data-rail>
      {cases.map((c) => <CaseCard card={c.card} href={casePath(c.slug)} />)}
    </div>
  </div>
</section>

<script>
  import { initRail } from '../../scripts/rail';
  document.querySelectorAll<HTMLElement>('[data-rail-root]').forEach(initRail);
</script>

<style>
  .arrows { display: flex; gap: 8px; flex-shrink: 0; }
  button {
    width: 40px; height: 40px; border: 1px solid var(--ink); background: #fff; color: var(--ink);
    font: inherit; font-size: 15px; cursor: pointer;
  }
  button:disabled { border-color: var(--line); color: var(--line-strong); cursor: default; }
  .rail {
    display: flex; gap: 24px; margin-top: 56px; margin-right: calc(-1 * var(--gutter)); padding-right: var(--gutter);
    overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding-bottom: 8px; padding-top: 6px;
  }
  .rail::-webkit-scrollbar { display: none; }
  @media (max-width: 900px) {
    .rail { margin-top: 32px; gap: 14px; margin-right: calc(-1 * var(--gutter-mobile)); padding-right: var(--gutter-mobile); }
  }
</style>

---
import { site } from '../../data/site';
import { withBase } from '../../lib/paths';
---

<header class="hero">
  <div class="wrap">
    <p class="eyebrow" data-hero-line style="--line:0">{site.eyebrow}</p>
    <h1>
      {site.heroLines.map((line, i) => (
        <>
          <span class="line" data-hero-line style={`--line:${i + 1}`} set:html={line} />
          {i < site.heroLines.length - 1 && ' '}
        </>
      ))}
    </h1>
    <p class="intro" data-hero-line style="--line:3">{site.heroIntro}</p>
    <div class="ctas" data-hero-line style="--line:4">
      <a class="btn btn--fill" href={withBase('/#work')}>Selected Work <span class="arr" aria-hidden="true">→</span></a>
      <a class="btn btn--line" href={withBase('/#research')}>Research Reports</a>
    </div>

    <dl class="creds" aria-label="학력 · 경력 요약" data-credentials>
      {site.credentials.map((c) => (
        <div class="cred">
          <dt>{c.label}</dt>
          <dd>{c.value}<span>{c.sub}</span></dd>
        </div>
      ))}
    </dl>
  </div>
</header>

<style>
  .hero { padding: 112px 0 0; }
  .eyebrow { color: var(--accent); }
  h1 { margin-top: 24px; font-size: 60px; font-weight: 500; letter-spacing: -0.035em; line-height: 1.2; max-width: 900px; }
  .line { display: block; }
  h1 :global(b) { font-weight: 800; color: var(--navy); }
  .intro { margin-top: 28px; max-width: 640px; font-size: 17px; line-height: 1.75; color: var(--ink-2); }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 40px; }

  .creds {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: 96px; border-top: 1px solid var(--line);
  }
  .cred { padding: 24px 24px 28px; border-left: 1px solid var(--line); }
  .cred:first-child { padding-left: 0; border-left: 0; }
  dt { font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-3); }
  dd { margin-top: 8px; font-size: 15px; font-weight: 600; color: var(--ink); line-height: 1.5; }
  dd span { display: block; margin-top: 2px; font-size: 13px; font-weight: 400; color: var(--ink-3); }

  @media (max-width: 1100px) {
    .creds { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cred:nth-child(3) { padding-left: 0; border-left: 0; }
    .cred:nth-child(n + 3) { border-top: 1px solid var(--line); }
  }
  @media (max-width: 900px) {
    .hero { padding-top: 56px; }
    h1 { margin-top: 16px; font-size: 34px; line-height: 1.3; }
    .intro { margin-top: 20px; font-size: 15px; }
    .ctas { margin-top: 28px; }
    .creds { grid-template-columns: minmax(0, 1fr); margin-top: 56px; }
    .cred, .cred:nth-child(3) { padding: 16px 0; border-left: 0; border-top: 1px solid var(--line); display: grid; grid-template-columns: 92px 1fr; gap: 12px; }
    .cred:first-child { border-top: 0; }
    dt { padding-top: 2px; font-size: 11px; }
    dd { margin-top: 0; font-size: 14px; }
  }
  @media (max-width: 520px) {
    .ctas .btn { flex: 1 1 auto; padding: 0 18px; }
  }
</style>

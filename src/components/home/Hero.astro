---
import { site } from '../../data/site';
import { withBase } from '../../lib/paths';
---

<header class="hero">
  <div class="wrap">
    <p class="eyebrow">{site.eyebrow}</p>
    <h1>
      {site.heroLines.map((line, i) => (
        <>
          <span class="line" data-hero-line style={`--line:${i}`} set:html={line} />
          {i < site.heroLines.length - 1 && ' '}
        </>
      ))}
    </h1>
    <div class="foot">
      <p class="facts">{site.heroFacts}</p>
      <a class="btn btn--fill" href={withBase('/#work')}>프로젝트 보기 →</a>
    </div>
  </div>
</header>

<style>
  .hero { padding: 110px 0 100px; }
  h1 { margin-top: 52px; font-size: 76px; font-weight: 500; letter-spacing: -0.035em; line-height: 1.14; }
  .line { display: block; }
  h1 :global(b) { font-weight: 800; color: var(--navy); }
  .foot { display: flex; justify-content: space-between; align-items: flex-end; gap: 40px; margin-top: 64px; }
  .facts { font-size: 16px; color: var(--ink-2); }
  .btn { flex-shrink: 0; }
  @media (max-width: 900px) {
    .hero { padding: 64px 0 56px; }
    h1 { margin-top: 28px; font-size: 34px; line-height: 1.3; }
    .foot { flex-direction: column; align-items: flex-start; gap: 24px; margin-top: 32px; }
    .facts { font-size: 14px; }
  }
</style>

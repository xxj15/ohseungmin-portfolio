---
import { site } from '../../data/site';
import { withBase } from '../../lib/paths';
---

<div class="strip" aria-label="경력" data-experience>
  <div class="wrap row">
    <span class="eyebrow label">Experience</span>
    <ul>
      {site.experience.map((item) => <li><a href={withBase(item.href)}>{item.name}</a></li>)}
    </ul>
  </div>
</div>

<style>
  .strip { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 22px 0; }
  .row { display: flex; align-items: center; gap: 28px; }
  .label { font-size: 11px; flex-shrink: 0; }
  ul { display: flex; flex-wrap: wrap; gap: 8px 28px; font-size: 15px; color: var(--ink-2); }
  li + li::before { content: '·'; color: var(--line-strong); margin-right: 28px; }
  a { background: linear-gradient(var(--navy), var(--navy)) 0 100% / 0 1px no-repeat; transition: color 0.2s, background-size 0.24s; padding-bottom: 2px; }
  a:hover, a:focus-visible { color: var(--navy); background-size: 100% 1px; }
  @media (prefers-reduced-motion: reduce) { a { transition: none; } }
  @media (max-width: 900px) {
    .row { flex-direction: column; align-items: flex-start; gap: 12px; }
    ul { gap: 6px 14px; font-size: 13px; }
    li + li::before { margin-right: 14px; }
  }
</style>

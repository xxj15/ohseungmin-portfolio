---
import type { CaseStudy } from '../../data/types';
import { withBase } from '../../lib/paths';

interface Props { c: CaseStudy }
const { c } = Astro.props;
---

<div class="wrap">
  <p class="crumb"><a href={withBase('/#work')}>← 주요 프로젝트</a> <span>/ {c.no}</span></p>
  <header class="head">
    <p class="eyebrow">{c.eyebrow}</p>
    <h1>{c.title}</h1>
    <p class="org">{c.org}</p>
    <dl class="facts">
      {c.facts.map((f) => (
        <div data-fact>
          <dt>{f.label}</dt>
          <dd>
            {f.links && f.links.length > 0 ? (
              f.links.map((link, i) => (
                <>
                  {i > 0 && ' · '}
                  <a href={withBase(link.href)} target="_blank" rel="noopener">{link.text}</a>
                </>
              ))
            ) : (
              <span set:html={f.value} />
            )}
          </dd>
        </div>
      ))}
    </dl>
  </header>
</div>

<style>
  .crumb { padding-top: 40px; font-size: 14px; color: var(--ink-3); }
  .crumb a { display: inline-flex; align-items: center; min-height: 44px; color: var(--ink-2); }
  .crumb a:hover { color: var(--accent); }
  .head .eyebrow { color: var(--accent); }
  .crumb span { margin-left: 6px; }
  .head { padding: 56px 0 64px; }
  h1 { margin-top: 20px; font-size: 46px; font-weight: 700; letter-spacing: -0.03em; line-height: 1.28; max-width: 920px; }
  .org { margin-top: 20px; font-size: 18px; color: var(--ink-2); }
  .facts { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--navy); margin-top: 48px; }
  .facts div { padding: 18px 20px 0 0; }
  dt { font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-3); }
  dd { margin-top: 6px; font-size: 16px; font-weight: 600; color: var(--ink); }
  dd a { color: var(--accent); border-bottom: 1px solid var(--accent); }
  @media (max-width: 900px) {
    .crumb { padding-top: 24px; }
    .head { padding: 32px 0 40px; }
    h1 { margin-top: 14px; font-size: 28px; line-height: 1.35; }
    .org { font-size: 16px; margin-top: 12px; }
    .facts { grid-template-columns: 1fr 1fr; margin-top: 32px; row-gap: 16px; }
    dd { font-size: 14px; }
  }
</style>

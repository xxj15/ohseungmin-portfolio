---
interface Props { text: string }
const { text } = Astro.props;
---

<p class="notice" role="note">{text}</p>

<style>
  .notice { background: var(--tint); border-left: 3px solid var(--navy); border-radius: 0 var(--radius) var(--radius) 0; padding: 16px 20px; font-size: 14px; color: var(--ink-2); max-width: 820px; }
</style>

---
interface Props { items: { tag: string; title: string; body: string }[] }
const { items } = Astro.props;
---

<div class="thesis">
  {items.map((t) => (
    <div class="th">
      <p class="tag">{t.tag}</p>
      <h3>{t.title}</h3>
      <p class="body">{t.body}</p>
    </div>
  ))}
</div>

<style>
  .thesis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .th { border-top: 2px solid var(--navy); padding-top: 18px; }
  .tag { font-size: 12px; letter-spacing: 0.04em; color: var(--navy); font-weight: 600; }
  h3 { margin-top: 8px; font-size: 19px; font-weight: 700; letter-spacing: -0.01em; line-height: 1.45; }
  .body { margin-top: 10px; font-size: 14px; color: var(--ink-2); line-height: 1.75; }
  @media (max-width: 900px) { .thesis { grid-template-columns: 1fr; gap: 24px; } h3 { font-size: 17px; } }
</style>

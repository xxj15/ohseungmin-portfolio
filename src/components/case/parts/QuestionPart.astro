---
interface Props { text: string }
const { text } = Astro.props;
---

<p class="lead">{text}</p>

<style>
  .lead { color: var(--ink); font-size: 28px; font-weight: 600; line-height: 1.5; letter-spacing: -0.02em; max-width: 820px; }
  @media (max-width: 900px) { .lead { font-size: 21px; } }
</style>

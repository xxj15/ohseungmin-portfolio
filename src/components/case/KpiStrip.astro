---
import type { Kpi } from '../../data/types';

interface Props { kpis: Kpi[] }
const { kpis } = Astro.props;

/** '43,300' · '+30' · '15.9'처럼 숫자만 있는 값만 카운트업한다('1조 7,361', 'SQL' 등은 그대로). */
function countup(value: string) {
  const m = /^([+-]?)(\d{1,3}(?:,\d{3})+|\d+)(?:\.(\d+))?$/.exec(value);
  if (!m) return null;
  const decimals = m[3]?.length ?? 0;
  return { prefix: m[1], comma: m[2].includes(','), decimals, value: Number(`${m[2].replace(/,/g, '')}${decimals ? '.' + m[3] : ''}`) };
}
---

<div class="strip" data-kpi-strip>
  <div class="wrap grid">
    {kpis.map((k) => (
      <div class="kpi" data-kpi>
        <p class="n">
          {(() => {
            const c = countup(k.value);
            return c ? (
              <span class="cu" data-countup data-countup-value={c.value} data-countup-decimals={c.decimals} data-countup-prefix={c.prefix} data-countup-comma={String(c.comma)}>
                <span class="final">{k.value}</span><span class="layer" aria-hidden="true"></span>
              </span>
            ) : (
              k.value
            );
          })()}
          {k.unit && <small>{k.unit}</small>}
        </p>
        <p class="l">{k.label}</p>
      </div>
    ))}
  </div>
</div>

<style>
  .strip { background: var(--tint); }
  .grid { display: grid; grid-template-columns: repeat(4, 1fr); padding-top: 56px; padding-bottom: 56px; }
  .kpi { padding: 0 24px; border-right: 1px solid var(--line-strong); }
  .kpi:first-child { padding-left: 0; }
  .kpi:last-child { border-right: 0; }
  .n { font-size: 40px; font-weight: 700; letter-spacing: -0.03em; line-height: 1.1; color: var(--navy); }
  .n small { font-size: 20px; margin-left: 4px; }
  .l { margin-top: 12px; font-size: 14px; color: var(--ink-3); }
  .cu { position: relative; display: inline-block; font-variant-numeric: tabular-nums; }
  .layer { position: absolute; left: 0; top: 0; white-space: nowrap; }
  .cu:global(.is-counting) .final { visibility: hidden; }
  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr 1fr; padding-top: 28px; padding-bottom: 28px; row-gap: 24px; }
    .kpi { padding: 0 12px; }
    .kpi:nth-child(odd) { padding-left: 0; }
    .kpi:nth-child(2) { border-right: 0; }
    .n { font-size: 28px; }
    .n small { font-size: 14px; }
    .l { font-size: 12px; margin-top: 6px; }
  }
</style>
